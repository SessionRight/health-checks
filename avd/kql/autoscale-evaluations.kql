// Scaling plan evaluations
// Source: https://sessionright.com/blog/avd-scaling-plan-guide
// License: MIT
// Read-only: a query. It changes nothing.

WVDAutoscaleEvaluationPooled
| where TimeGenerated > ago(1d)
| project TimeGenerated, ConfigSchedulePhase, ResultType, SessionCount, SessionOccupancyPercent,
          ActiveSessionHostCount, ExcludedSessionHostCount, UnhealthySessionHostCount,
          MaxSessionLimitPerSessionHost, ScalingReasonMessage
| order by TimeGenerated desc
